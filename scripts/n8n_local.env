# n8n local (Docker-free) configuration for Windows
# This file is loaded by scripts/start_n8n_local.cmd
# Notes:
# - Default DB is SQLite (no external DB needed)
# - UI at http://localhost:5678
# - Change N8N_ENCRYPTION_KEY to a unique secret (32+ random hex chars)

# Core
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
TZ=UTC

# Database (SQLite)
DB_TYPE=sqlite
DB_SQLITE_VACUUM_ON_STARTUP=true

# Executions and storage
EXECUTIONS_MODE=regular
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336    # hours (14 days)
EXECUTIONS_DATA_HARD_DELETE_INTERVAL=3600
EXECUTIONS_DATA_SOFT_DELETE_INTERVAL=3600

# Security and telemetry
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_RANDOM_HEX_64
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false

# Auth (optional - keep off for local testing)
#N8N_BASIC_AUTH_ACTIVE=true
#N8N_BASIC_AUTH_USER=admin
#N8N_BASIC_AUTH_PASSWORD=please_change

# Logs
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
